{
  "name": "@agentpulse/desktop",
  "version": "0.1.0",
  "description": "AgentPulse desktop client — an AI company workbench for one-person companies.",
  "author": "AgentPulse",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 0.0.0.0 --port 5174\" \"wait-on http://127.0.0.1:5174 && npm run build:electron && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5174 electron .\"",
    "dev:renderer": "vite --host 127.0.0.1 --port 5174",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build": "tsc -b && vite build && tsc -p electron/tsconfig.json",
    "prepare:runtime": "node scripts/build-hermes-runtime.mjs",
    "verify:runtime": "node scripts/verify-hermes-runtime.mjs",
    "test:local-project-path": "npm run build:electron && node scripts/test-local-project-path.mjs",
    "start": "electron .",
    "lint": "tsc --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "package:mac": "npm run build && npm run prepare:runtime -- --platform=darwin --arch=arm64 && npm run verify:runtime && electron-builder --mac",
    "package:win": "npm run build && npm run prepare:runtime -- --platform=win32 --arch=x64 && npm run verify:runtime && electron-builder --win",
    "package:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "i18next": "^26.3.6",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.9",
    "vite": "^6.0.5"
  },
  "devDependencies": {
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "concurrently": "9.2.4",
    "cross-env": "^7.0.3",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "typescript": "^5.7.2",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "cc.agentpulse.desktop",
    "productName": "AgentPulse",
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "extraResources": [
      {
        "from": "runtime-stage",
        "to": "hermes-runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "artifactName": "AgentPulse-mac-${arch}.${ext}",
      "icon": "resources/icon.icns",
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null
    },
    "win": {
      "artifactName": "AgentPulse-windows-${arch}.${ext}",
      "icon": "resources/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "resources/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Office"
    }
  }
}
